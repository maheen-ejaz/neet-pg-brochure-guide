  "notes": [
    {
      "id": "note-tentative",
      "sourcePages": [
        1
      ],
      "verified": false,
      "title": "These dates are tentative",
      "detail": "MCC calls this a tentative schedule, so the dates can change. Check MCC's website for the final dates before each round."
    },
    {
      "id": "note-server-time",
      "sourcePages": [
        1,
        2,
        3,
        4
      ],
      "verified": false,
      "title": "All times are MCC server time",
      "detail": "Registration closes at 12:00 noon, but payment stays open until 3:00 PM the same day. In Rounds 1 to 3, choice locking opens at 4:00 PM the day before choice filling ends."
    },
    {
      "id": "note-round2-seat-matrix",
      "sourcePages": [
        2
      ],
      "verified": false,
      "title": "Round 2 seat matrix closes at 1:00 PM",
      "detail": "Colleges verify the Round 2 seat matrix on 06-11-2026 and up to 1:00 PM on 07-11-2026."
    },
    {
      "id": "note-stray-time",
      "sourcePages": [
        4
      ],
      "verified": false,
      "title": "Stray round: choices until 11:55 PM",
      "detail": "In the stray vacancy round, choice filling and locking run until 11:55 PM on 21-12-2026, not 10:00 AM as in Rounds 1 to 3. The result and reporting both start on 24-12-2026."
    },
    {
      "id": "note-session-start",
      "sourcePages": [
        2,
        4
      ],
      "verified": false,
      "title": "The session starts during Round 2 reporting",
      "detail": "The PG academic session begins on 20-11-2026, while Round 2 reporting runs until 23-11-2026. By these dates, Round 3 and stray-round candidates join after classes have begun."
    },
    {
      "id": "note-weekends",
      "sourcePages": [
        4
      ],
      "verified": false,
      "title": "Weekends and holidays are working days",
      "detail": "Participating colleges are advised to treat all Saturdays, Sundays and gazetted holidays as working days, to keep to the schedule."
    }
  ],
